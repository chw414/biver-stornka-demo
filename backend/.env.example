NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://booking_app:CHANGE_ME@localhost:5432/serwis
# adres frontendu (CORS) — dokładny origin, bez "*"
CORS_ORIGIN=http://localhost:5173
# w produkcji wymagany (rate limiting współdzielony między instancjami + BullMQ)
REDIS_URL=redis://localhost:6379
# liczba proxy przed aplikacją (Caddy / Cloudflare) — potrzebne do poprawnego IP klienta
TRUST_PROXY=1
# limity rezerwacji
BOOKING_LIMIT_PER_IP=5
BOOKING_LIMIT_PER_IP_WINDOW_SEC=600
BOOKING_LIMIT_PER_PHONE=3
BOOKING_LIMIT_PER_PHONE_WINDOW_SEC=3600
# --- panel admina ---
# wygeneruj: openssl rand -base64 48   (dwa RÓŻNE sekrety)
JWT_SECRET=
CSRF_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
# tylko do lokalnego developmentu po http://localhost (w produkcji wymuszone true)
COOKIE_SECURE=false
LOGIN_LIMIT_PER_IP=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# --- powiadomienia i integracje (szczegóły: docs/integracje.md) ---
BUSINESS_NAME=Biver
BUSINESS_PHONE=14 685 87 80
BUSINESS_ADDRESS=ul. Ludwika Solskiego 38, 32-800 Brzesko
WHATSAPP_MODE=log
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=pl
GOOGLE_CALENDAR_MODE=log
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_INCLUDE_PII=false
